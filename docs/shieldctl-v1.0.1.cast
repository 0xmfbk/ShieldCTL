[0.508208, "o", "\r\n"]
[0.522984, "o", "\u001b[34m========================================\u001b[0m\r\n\u001b[34m              ShieldCTL\u001b[0m\r\n\u001b[2m     Linux security and hardening toolkit\u001b[0m\r\n\u001b[34m========================================\u001b[0m\r\n\r\nshieldctl 1.0.1\r\n"]
[0.775371, "o", "\u001b[1;32m$\u001b[0m /home/mfbkadmin/ShieldCTL/shieldctl --help"]
[0.77566, "o", "\r\n"]
[0.789183, "o", "\u001b[34m========================================\u001b[0m"]
[0.789654, "o", "\r\n\u001b[34m              ShieldCTL\u001b[0m\r\n\u001b[2m     Linux security and hardening toolkit\u001b[0m\r\n\u001b[34m========================================\u001b[0m\r\n\r\n"]
[0.791304, "o", "shieldctl 1.0.1 - lightweight Linux hardening, audit and scheduling"]
[0.79148, "o", "\r\n"]
[0.792053, "o", "\r\nUSAGE: shieldctl <command> [options]\r\n\r\n  status                         dashboard of all protection layers (read-only)\r\n  install [--usbguard] [--firewall]\r\n                                 install lynis rkhunter clamav aide fail2ban auditd\r\n  harden [module...]             default: sysctl modules coredump perms firewall\r\n                                 extra:   umask usbguard   (or: all)\r\n  rollback                       undo everything shieldctl changed\r\n  services [list|disable <n>..]  review/disable risky services (reversible)\r\n  scan <what>                    audit | rootkit | malware | integrity | updates | ports | all\r\n  aide <init|check|update|accept> file-integrity baseline (CHECK before UPDATE)\r\n"]
[0.792433, "o", "  schedule <list|add|remove|run|defaults>\r\n                                 timers, e.g.:  schedule add weekly-av \"scan malware\" weekly\r\n  report                         recent results\r\n  menu                           interactive menu\r\n  self-install / self-uninstall  copy to /usr/local/bin (needed for schedules)\r\n\r\nOPTIONS\r\n  -n, --dry-run     show what would change, change nothing\r\n  -y, --yes         assume yes\r\n    --allow-port PORT/PROTO\r\n                    allow a port without prompting (repeatable, e.g. 22/tcp)\r\n    --auto-apply-updates\r\n                    opt in to enabling a timer that applies package updates\r\n-q, --quiet       only warnings/errors (used by timers)\r\n      --path DIR    scan malware: directory to scan (repeatable)\r\n      --bg          aide: run in background via systemd-run\r\n      --rebuild-confirmed\r\n                    internal: authorize a confirmed background AIDE rebuild\r\n"]
[1.046053, "o", "\r\n\u001b[1;38;5;117m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1;36m  02  •  READ-ONLY SYSTEM STATUS\u001b[0m\r\n\u001b[1;38;5;117m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
