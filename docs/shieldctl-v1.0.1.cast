[0.002869, "o", "\u001b[2J\u001b[H\u001b[1;38;5;117m╔══════════════════════════════════════════════════════════════════════╗\u001b[0m\r\n\u001b[1;38;5;117m║                                                                      ║\u001b[0m\r\n\u001b[1;38;5;117m║                            ShieldCTL                                 ║\u001b[0m\r\n\u001b[1;38;5;117m║                                                                      ║\u001b[0m\r\n\u001b[1;38;5;117m║                              0xmfbk                                  ║\u001b[0m\r\n\u001b[1;38;5;117m║                                                                      ║\u001b[0m\r\n\u001b[1;38;5;117m╚══════════════════════════════════════════════════════════════════════╝\u001b[0m\r\n\u001b[2mThis demo is read-only except for isolated test temporary files.\u001b[0m\r\n"]
[0.255118, "o", "\r\n\u001b[1;38;5;117m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m"]
[0.255296, "o", "\r\n\u001b[1;36m  01  •  VERSION AND HELP\u001b[0m\r\n\u001b[1;38;5;117m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
