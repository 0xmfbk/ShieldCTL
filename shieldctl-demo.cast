[3.012279, "o", "\r\n"]
[3.012438, "o", "\u001b[1;36m╔═══════════════════════════════════════════════════════════════════════════════════════════════════╗\u001b[0m\r\n\u001b[1;36m║                                             \u001b[1mShieldCTL\u001b[0m                                             ║\u001b[0m"]
[3.01255, "o", "\r\n\u001b[1;36m║                          \u001b[2mby 0xmfbk  •  Linux security hardening toolkit\u001b[0m                           ║\u001b[0m\r\n"]
[3.012741, "o", "\u001b[1;36m╚═══════════════════════════════════════════════════════════════════════════════════════════════════╝\u001b[0m\r\n\r\n\u001b[2mThis recording applies no hardening changes.\u001b[0m\r\n"]
[3.01278, "o", "\u001b[2mAll ShieldCTL commands run with sudo for complete system visibility.\u001b[0m\r\n"]
[6.025364, "o", "\r\n\u001b[1;33m▸ Version and capabilities\u001b[0m\r\n\u001b[1;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n\u001b[1;32m▶\u001b[0m Show the installed ShieldCTL version\r\n\u001b[2m$ sudo shieldctl --version\u001b[0m\r\n\r\n"]
[6.047921, "o", "\u001b[34m========================================\u001b[0m\r\n\u001b[34m              ShieldCTL\u001b[0m\r\n\u001b[2m     Linux security and hardening toolkit\u001b[0m\r\n\u001b[34m========================================\u001b[0m\r\n\r\nshieldctl 1.0.0\r\n"]
[8.050844, "o", "\r\n\u001b[1;32m▶\u001b[0m Show available commands and safety options\r\n\u001b[2m$ sudo shieldctl --help\u001b[0m\r\n\r\n"]
[8.061879, "o", "\u001b[34m========================================\u001b[0m\r\n\u001b[34m              ShieldCTL\u001b[0m\r\n\u001b[2m     Linux security and hardening toolkit\u001b[0m\r\n\u001b[34m========================================\u001b[0m\r\n\r\n"]
[8.062488, "o", "shieldctl 1.0.0 - lightweight Linux hardening, audit and scheduling\r\n\r\nUSAGE: shieldctl <command> [options]"]
[8.062657, "o", "\r\n\r\n  status                         dashboard of all protection layers (read-only)\r\n  install [--usbguard] [--firewall]\r\n                                 install lynis rkhunter clamav aide fail2ban auditd\r\n  harden [module...]             default: sysctl modules coredump perms firewall\r\n                                 extra:   umask usbguard   (or: all)\r\n  rollback                       undo everything shieldctl changed"]
[8.062776, "o", "\r\n  services [list|disable <n>..]  review/disable risky services (reversible)\r\n  scan <what>                    audit | rootkit | malware | integrity | updates | ports | all\r\n  aide <init|check|update|accept> file-integrity baseline (CHECK before UPDATE)\r\n  schedule <list|add|remove|run|defaults>\r\n                                 timers, e.g.:  schedule add weekly-av \"scan malware\" weekly\r\n  report                         recent results\r\n  menu                           interactive menu\r\n"]
[8.06282, "o", "  self-install / self-uninstall  copy to /usr/local/bin (needed for schedules)\r\n\r\nOPTIONS\r\n  -n, --dry-run     show what would change, change nothing\r\n  -y, --yes         assume yes\r\n  -q, --quiet       only warnings/errors (used by timers)\r\n"]
[8.063215, "o", "      --path DIR    scan malware: directory to scan (repeatable)\r\n      --bg          aide: run in background via systemd-run\r\n"]
[10.066131, "o", "\r\n\u001b[1;33m▸ Current security posture\u001b[0m\r\n\u001b[1;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n\u001b[1;32m▶\u001b[0m Display protection layers, kernel hardening, and exposure\r\n\u001b[2m$ sudo shieldctl status\u001b[0m\r\n\r\n"]
[10.090903, "o", "\u001b[34m========================================\u001b[0m\r\n"]
