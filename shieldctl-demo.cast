[12.724479, "o", "\r\n\u001b[1;33m▸ Safe hardening preview\u001b[0m\r\n\u001b[1;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n\u001b[1;32m▶\u001b[0m Preview the default hardening plan without changing the system\r\n\u001b[2m$ sudo shieldctl --dry-run harden\u001b[0m\r\n\r\n"]
[12.735221, "o", "\u001b[34m========================================\u001b[0m\r\n\u001b[34m              ShieldCTL\u001b[0m\r\n\u001b[2m     Linux security and hardening toolkit\u001b[0m\r\n\u001b[34m========================================\u001b[0m\r\n\r\n"]
[12.736349, "o", "\u001b[34m[*]\u001b[0m Hardening plan: sysctl modules coredump perms firewall\r\n\u001b[34m[*]\u001b[0m Every step below reports its intended effect and result.\r\n"]
[12.736595, "o", "\r\n\u001b[34m--- Step: sysctl ---\u001b[0m\r\n"]
[12.736823, "o", "\u001b[34m[*]\u001b[0m Tests and applies supported kernel/network sysctl values, skipping unsupported keys.\r\n\u001b[34m[*]\u001b[0m sysctl: kernel and network hardening\r\n"]
[12.74826, "o", "\u001b[34m[*]\u001b[0m would write /etc/sysctl.d/99-shieldctl.conf"]
[12.748654, "o", "\r\n"]
[12.749255, "o", "\u001b[32m[+]\u001b[0m sysctl: would apply 29 keys, 0 unsupported/skipped\r\n"]
[12.749399, "o", "\u001b[32m[+]\u001b[0m step completed: sysctl\r\n\r\n\u001b[34m--- Step: modules ---\u001b[0m\r\n"]
[12.749519, "o", "\u001b[34m[*]\u001b[0m Writes module deny rules for selected obsolete or high-risk kernel modules.\r\n\u001b[34m[*]\u001b[0m blocking unused kernel modules/protocols\r\n"]
[12.750005, "o", "\u001b[34m[*]\u001b[0m would write /etc/modprobe.d/shieldctl-blacklist.conf\r\n"]
[12.750895, "o", "\u001b[32m[+]\u001b[0m step completed: modules\r\n"]
[12.750975, "o", "\r\n\u001b[34m--- Step: coredump ---\u001b[0m\r\n"]
[12.751088, "o", "\u001b[34m[*]\u001b[0m Disables traditional and systemd core dumps.\r\n\u001b[34m[*]\u001b[0m disabling core dumps"]
[12.75131, "o", "\r\n"]
[12.751595, "o", "\u001b[34m[*]\u001b[0m would write /etc/security/limits.d/99-shieldctl-nocore.conf\r\n"]
[12.753209, "o", "\u001b[34m[*]\u001b[0m would write /etc/systemd/coredump.conf.d/shieldctl.conf\r\n"]
[12.754115, "o", "\u001b[32m[+]\u001b[0m step completed: coredump\r\n"]
[12.754217, "o", "\r\n\u001b[34m--- Step: perms ---\u001b[0m\r\n"]
[12.754326, "o", "\u001b[34m[*]\u001b[0m Tightens selected permissions only; existing permissions are backed up.\r\n\u001b[34m[*]\u001b[0m tightening permissions (only ever stricter, never looser)\r\n"]
[12.755317, "o", "\u001b[34m[*]\u001b[0m would chmod 644 -> 600 /etc/crontab\r\n"]
[12.756268, "o", "\u001b[34m[*]\u001b[0m would chmod 755 -> 700 /etc/cron.d"]
[12.756441, "o", "\r\n"]
[12.757444, "o", "\u001b[34m[*]\u001b[0m would chmod 755 -> 700 /etc/cron.daily\r\n"]
[12.758535, "o", "\u001b[34m[*]\u001b[0m would chmod 755 -> 700 /etc/cron.hourly\r\n"]
[12.759572, "o", "\u001b[34m[*]\u001b[0m would chmod 755 -> 700 /etc/cron.weekly\r\n"]
[12.760775, "o", "\u001b[34m[*]\u001b[0m would chmod 755 -> 700 /etc/cron.monthly\r\n"]
[12.761863, "o", "\u001b[34m[*]\u001b[0m would chmod 644 -> 600 /etc/ssh/sshd_config"]
[12.762254, "o", "\r\n"]
[12.762955, "o", "\u001b[34m[*]\u001b[0m would chmod 755 -> 750 /etc/sudoers.d\r\n"]
[12.763049, "o", "\u001b[32m[+]\u001b[0m permissions: 0 paths tightened\r\n"]
[12.763139, "o", "\u001b[32m[+]\u001b[0m step completed: perms\r\n\r\n\u001b[34m--- Step: firewall ---\u001b[0m\r\n"]
[12.763221, "o", "\u001b[34m[*]\u001b[0m Lists every exposed listener and asks whether each port should be blocked or preserved.\r\n"]
[12.763363, "o", "\u001b[34m[*]\u001b[0m firewall: deny unsolicited incoming traffic and allow outgoing traffic\r\n"]
[12.771081, "o", "\u001b[33m[!]\u001b[0m Firewall warning: default-deny incoming may block these listeners:\r\n"]
[12.777609, "o", "\u001b[33m[!]\u001b[0m   - tcp port 22 on 0.0.0.0:22\r\n\u001b[34m[*]\u001b[0m dry-run: would ask whether to preserve tcp/22\r\n"]
[12.777727, "o", "\u001b[33m[!]\u001b[0m   - udp port 546 on [fe80::8344:470b:3634:a402]%enp1s0:546\r\n"]
[12.77783, "o", "\u001b[34m[*]\u001b[0m dry-run: would ask whether to preserve udp/546\r\n\u001b[33m[!]\u001b[0m   - udp port 68 on 192.168.100.159:68\r\n\u001b[34m[*]\u001b[0m dry-run: would ask whether to preserve udp/68\r\n"]
[12.778526, "o", "\u001b[33m[dry-run]\u001b[0m ufw default deny incoming\r\n\u001b[33m[dry-run]\u001b[0m ufw default allow outgoing\r\n\u001b[33m[dry-run]\u001b[0m ufw logging on\r\n\u001b[33m[dry-run]\u001b[0m ufw --force enable\r\n\u001b[34m[*]\u001b[0m Firewall result (UFW):\r\n\u001b[34m[*]\u001b[0m dry-run: UFW would deny incoming, allow outgoing, and enable logging\r\n\u001b[32m[+]\u001b[0m step completed: firewall\r\n\r\n\u001b[34m=== Hardening summary ===\u001b[0m\r\n  Requested: 5\r\n  Completed: 5\r\n  Skipped/failed: 0\r\n\u001b[32m[+]\u001b[0m hardening completed. Undo managed changes with: sudo shieldctl rollback\r\n"]
[14.781047, "o", "\r\n\u001b[1;33m▸ Network and activity visibility\u001b[0m\r\n\u001b[1;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m"]
[14.781556, "o", "\r\n\r\n\u001b[1;32m▶\u001b[0m Inspect exposed network listeners\r\n\u001b[2m$ sudo shieldctl scan ports\u001b[0m"]
[14.781874, "o", "\r\n\r\n"]
