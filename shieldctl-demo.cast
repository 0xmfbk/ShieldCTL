[10.722259, "o", "  2026-10-30T22:00  integrity  WARN  added=4 removed=0 changed=5 (no critical paths) log: /var/log/shieldctl/integrity-20261030-215953.log\r\n  2026-10-30T22:00  audit      WARN  hardening index 76, 1 warnings (lynis show report)\r\n  2026-10-30T22:03  integrity  WARN  added=4 removed=0 changed=6 (no critical paths) log: /var/log/shieldctl/integrity-20261030-220304.log\r\n  2026-10-30T22:08  rootkit    WARN  3 warnings (review /var/log/shieldctl/rootkit-20261030-220610.log; whitelist known-good in /etc/rkhunter.conf.local)\r\n  2026-10-30T22:54  ports      OK    4 listeners behind firewall (ufw): 0.0.0.0:22 192.168.100.159:68 [::]:22 [fe80::8344:470b:3634:a402]%enp1s0:546 \r\n"]
